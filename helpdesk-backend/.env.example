# ── Database Configuration ──────────────────────────────────────────────────
# Local PostgreSQL URL, Username and Password (default: localhost:5432)
DB_URL=jdbc:postgresql://localhost:5432/helpdesk?options=-c%20TimeZone=UTC
DB_USERNAME=postgres
DB_PASSWORD=1234

# Test Database Configuration (Optional - used when running test suite)
DB_TEST_URL=jdbc:postgresql://localhost:5432/helpdesk_test?options=-c%20TimeZone=UTC
DB_TEST_USERNAME=postgres
DB_TEST_PASSWORD=1234

# ── Security Configuration ──────────────────────────────────────────────────
# A secure 256-bit base64-encoded secret key for signing JWTs
JWT_SECRET=your_jwt_secret_here

# ── AI bot user config ──────────────────────────────────────────────────────
# System UUID assigned to the AI bot agent in the database
AI_BOT_USER_ID=a3454d31-5a64-4bb0-91ea-27cfbe64521d

# ── Azure Blob Storage (Optional - Fallback to local storage if blank) ──────
# Connection string for files storage
AZURE_STORAGE_CONNECTION_STRING=
# Container name inside Azure storage
AZURE_STORAGE_CONTAINER_NAME=attachments

# ── Azure OpenAI Embeddings (Optional - Fallback to standard OpenAI or Mock) 
# Endpoint URL (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=
# Api Key for Azure OpenAI
AZURE_OPENAI_API_KEY=
# Deployment name for embedding (e.g. text-embedding-3-large or text-embedding-3-small)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Api Version (e.g. 2024-08-01-preview)
AZURE_OPENAI_API_VERSION=

# ── Standard OpenAI API (Optional - used as fallback for embeddings) ────────
# Standard OpenAI API key (sk-proj-...)
OPENAI_API_KEY=

# ── Groq API Configuration (Required for Chat Completions / AI Copilot) ─────
# Groq API Key (gsk_...)
GROQ_API_KEY=your_groq_api_key_here
# Groq model to use (e.g. llama-3.3-70b-versatile or mixtral-8x7b-32768)
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Base URL for Groq API
GROQ_BASE_URL=https://api.groq.com/openai/v1
